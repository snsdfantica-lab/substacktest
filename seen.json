"""Per-article summarization using Claude Sonnet 4.6."""

from __future__ import annotations

import logging
import os
import time
from pathlib import Path

from anthropic import Anthropic, APIStatusError, RateLimitError

log = logging.getLogger(__name__)

ROOT = Path(__file__).resolve().parents[1]
PROMPT_PATH = ROOT / "prompts" / "per_article.md"

MODEL = "claude-sonnet-4-6"
MAX_TOKENS = 2500


def _client() -> Anthropic:
    return Anthropic(api_key=os.environ["ANTHROPIC_API_KEY"])


def _system_prompt() -> str:
    return PROMPT_PATH.read_text()


def _format_history(prior: list[dict]) -> str:
    if not prior:
        return "(No prior summaries cached for this author.)"
    lines = []
    for p in prior:
        title = p.get("title", "(untitled)")
        date = p.get("published_at", "")[:10]
        lines.append(f"### {date} — {title}")
        summary = (p.get("summary") or "").strip()
        # Compact: keep only first ~1200 chars to control input tokens.
        if len(summary) > 1200:
            summary = summary[:1200] + "...[truncated]"
        lines.append(summary)
        lines.append("")
    return "\n".join(lines)


def summarize_article(
    *,
    author: str,
    title: str,
    publication_url: str,
    post_url: str,
    published_at: str,
    article_text: str,
    prior_summaries: list[dict],
    tickers_focus: list[str] | None = None,
    is_paywalled_truncated: bool = False,
) -> str:
    client = _client()
    truncation_note = ""
    if is_paywalled_truncated:
        truncation_note = (
            "\n\nNOTE: This article appears to be **paywalled and we could not read "
            "the full body**. Summarize what's visible (typically the lede/preview), "
            "flag the truncation prominently in the TL;DR, and keep conviction low.\n"
        )

    user_msg = f"""## Metadata
- Author: {author}
- Title: {title}
- Publication: {publication_url}
- Post URL: {post_url}
- Published: {published_at}
- Tickers focus hint: {", ".join(tickers_focus) if tickers_focus else "(none)"}
{truncation_note}
## Author's recent prior summaries (newest first)
{_format_history(prior_summaries)}

## Article (full text)
<article>
{article_text}
</article>

Produce the analyst note now."""

    return _call_with_retry(client, _system_prompt(), user_msg)


def _call_with_retry(client: Anthropic, system: str, user: str, attempts: int = 4) -> str:
    delay = 4
    last_err: Exception | None = None
    for i in range(attempts):
        try:
            resp = client.messages.create(
                model=MODEL,
                max_tokens=MAX_TOKENS,
                system=system,
                messages=[{"role": "user", "content": user}],
            )
            chunks = [b.text for b in resp.content if getattr(b, "type", None) == "text"]
            return "\n".join(chunks).strip()
        except (RateLimitError, APIStatusError) as e:
            last_err = e
            log.warning("Claude API error (attempt %d/%d): %s", i + 1, attempts, e)
            time.sleep(delay)
            delay *= 2
    raise RuntimeError(f"Claude API failed after {attempts} attempts: {last_err}")
